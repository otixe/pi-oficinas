def _startup_team():
    # --equipo must be honored even if the implicit default file is absent.
    if __name__ == '__main__' and '--equipo' in sys.argv:
        index = sys.argv.index('--equipo') + 1
        if index >= len(sys.argv):
            raise ValueError('--equipo requiere ruta')
        return load_equipo(sys.argv[index])
    return load_equipo()


