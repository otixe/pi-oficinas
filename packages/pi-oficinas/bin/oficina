def select_team(config):
    """Bind one validated team before any command or filesystem mutation."""
    global TEAM, BASE, LEADER_BODY, REGISTRY, DISTRIBUTION, LEADER, AGENTS, ORDER, KEY_PREFIX
    TEAM = config
    BASE, LEADER_BODY, REGISTRY, DISTRIBUTION = paths(config)
    LEADER = config['lider']
    AGENTS = frozenset(config['oficinas'])
    ORDER = tuple(config['oficinas'])
    KEY_PREFIX = config['office_key_prefix']


def soul_path(agent):
    return configured_soul_path(TEAM, agent)


def parse_ficha(ficha, agent):
    parts = ficha.split('---', 2)
    if len(parts) < 3 or parts[0].strip():
        raise ValueError(f'Frontmatter inválido: {agent}')
    fields = {}
    for line in parts[1].splitlines():
        if ':' in line:
            key, value = line.split(':', 1)
            fields[key.strip()] = value.strip().strip('"')
    for key in ('model', 'thinking', 'tools', 'description'):
        if not fields.get(key):
            raise ValueError(f'Ficha {agent} sin {key}')
    raw_tools = [t.strip() for t in fields['tools'].split(',')]
    if not all(re.fullmatch(r'[a-zA-Z_][a-zA-Z_0-9]*', t) for t in raw_tools):
        raise ValueError(f'Ficha {agent} tools inválidas')
    fields['tools'] = frozenset(raw_tools)
    return parts[2].strip(), fields


def agent_ficha(agent):
    if agent not in AGENTS:
        raise ValueError(f'Agente fuera de allowlist: {agent}')
    path = LEADER_BODY / '.pi/agents' / f'{agent}.md'
    if not path.is_file():
        raise ValueError(f'Ficha inexistente: {agent}')
    ficha = path.read_text()
    prose, fields = parse_ficha(ficha, agent)
    allowed = (fields['tools'] - BACKGROUND_TOOLS) | COMMON_TOOLS | OFFICE_EXTENSION_TOOLS
    if 'bash' in fields['tools']:
        allowed |= BACKGROUND_TOOLS
    fields['allowed_tools'] = allowed
    return ficha, prose, fields


def verify_practitioner_fichas(body, agent, owner_tools):
    folder = body / '.pi' / 'agents'
    own = folder / f'{agent}.md'
    if not own.is_file():
        raise ValueError(f'Falta ficha de practicante {agent}')
    for path in folder.glob('*.md'):
        text = path.read_text()
        parts = text.split('---', 2)
        if len(parts) < 3 or parts[0].strip():
            raise ValueError(f'Frontmatter inválido en ficha de practicante {path.name}')
        enabled = re.findall(r'(?m)^enabled:[ \t]*(.*?)[ \t]*$', parts[1])
        if path == own:
            if enabled and enabled != ['true']:
                raise ValueError('Ficha de practicante propia deshabilitada o ambigua')
            _, fields = parse_ficha(text, agent)
            if fields['tools'] != owner_tools:
                raise ValueError('Tools de ficha de practicante distintas a la dueña')
        elif path.name == f'mini-{agent}.md':
            canonical = LEADER_BODY / '.pi' / 'agents' / path.name
            if not canonical.is_file() or text != canonical.read_text():
                raise ValueError('Ficha mini propia distinta de la copia líder')
            _, fields = parse_ficha(text, f'mini-{agent}')
            if (enabled != ['true'] or
                    (os.environ.get('PI_OFICINAS_MINI_MODEL') and fields['model'] != os.environ['PI_OFICINAS_MINI_MODEL']) or
                    fields['thinking'] != 'low' or
                    fields['tools'] & {'bash', 'edit', 'write', 'subagent', 'cb_task_review', 'cb_task_claim', 'cb_task_submit'}):
                raise ValueError('Ficha mini propia insegura o fuera de allowlist')
        elif enabled != ['false']:
            raise ValueError(f'Otra ficha habilitada o no deshabilitada: {path.name}')


